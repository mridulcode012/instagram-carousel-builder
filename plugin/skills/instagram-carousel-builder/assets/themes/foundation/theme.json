{
  "name": "foundation",
  "description": "The Buildable Labs website / Brand Foundation look: near-black substrate, Instrument Serif italic headlines in sentence case, one word on a solid blue block, blue mono kickers, Manrope bold for data and announcements, full-blue quote slides, square blue buttons, Weave pattern. The default theme.",
  "source": "brand/design-rules.md (Brand Foundation v01, July 2026)",
  "best_for": [
    "insight posts",
    "opinion and conviction pieces",
    "case studies with one hard number",
    "announcements"
  ],
  "css": "theme.css",
  "fill_types": [
    "quote"
  ],
  "defaults": {
    "mode": "dark",
    "colors": {
      "bg": "#0A0B0E",
      "text": "#F5F6F8",
      "muted": "#7A8296",
      "accent": "#6789EC",
      "fill": "#0B3FDE",
      "on_fill": "#FFFFFF"
    },
    "type": {
      "display": "Instrument Serif",
      "body": "Manrope",
      "mono": "JetBrains Mono",
      "display_case": "none",
      "scale": {
        "cover": 128,
        "headline": 88,
        "body": 40,
        "label": 34,
        "number": 230
      }
    },
    "layout": {
      "align": "left",
      "margin": 96,
      "texture": "weave",
      "counter": false,
      "handle": true,
      "progress": true,
      "swipe_cue": true,
      "cta_fill": false
    }
  },
  "variants": {
    "light": {
      "mode": "light",
      "colors": {
        "bg": "#F5F6F8",
        "text": "#0A0B0E",
        "muted": "#565D6E",
        "accent": "#0B3FDE",
        "fill": "#0B3FDE",
        "on_fill": "#FFFFFF"
      }
    },
    "blue": {
      "mode": "blue",
      "colors": {
        "bg": "#0B3FDE",
        "text": "#FFFFFF",
        "muted": "#C3D4FA",
        "accent": "#FFFFFF",
        "fill": "#0A0B0E",
        "on_fill": "#FFFFFF"
      }
    }
  },
  "options": {
    "texture": [
      "weave",
      "loop",
      "ascent",
      "none"
    ],
    "variant": [
      "(dark default)",
      "light",
      "blue"
    ]
  }
}
