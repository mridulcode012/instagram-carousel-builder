{
  "name": "crt",
  "brand": "free",
  "description": "Retro terminal on a CRT monitor: phosphor green on near-black, VT323 pixel headlines with a '> ' prompt and a solid cursor block, IBM Plex Mono for everything else, inverse-video emphasis, a thin screen frame with phosphor progress segments cut into its top edge and the footer cut into its bottom edge, faint scanlines, a soft phosphor glow and a curved-tube vignette. Visuals become terminal UI (bracketed window bars, ncurses-style dialogs, inverse-video selections). Quote slides flip to full phosphor. An amber variant swaps the phosphor colour. Off-brand by design.",
  "source": "Free theme built from the brief 'retro terminal / CRT monitor', October 2026. Not from template photos.",
  "best_for": [
    "developer tool and CLI posts",
    "product news for builders (commands, plugins, releases)",
    "hacker-ish how-tos and checklists",
    "nostalgic or playful tech hooks"
  ],
  "css": "theme.css",
  "fill_types": [
    "quote"
  ],
  "palette": {
    "crt-black": "#050A06",
    "phosphor": "#A6FFBA",
    "p1-green": "#39FF6E",
    "phosphor-dim": "#5FBF78",
    "amber-black": "#0B0703",
    "amber-glow": "#FFD48F",
    "amber": "#FFB000",
    "amber-dim": "#C98A2B",
    "shadow": "#000000"
  },
  "fonts": [
    {
      "family": "VT323",
      "google": "VT323",
      "fallback": "'IBM Plex Mono', 'Courier New', monospace"
    },
    {
      "family": "IBM Plex Mono",
      "google": "IBM+Plex+Mono:wght@400;500;700",
      "fallback": "'Courier New', monospace"
    }
  ],
  "defaults": {
    "mode": "dark",
    "colors": {
      "bg": "#050A06",
      "text": "#A6FFBA",
      "muted": "#5FBF78",
      "accent": "#39FF6E",
      "fill": "#39FF6E",
      "on_fill": "#050A06"
    },
    "type": {
      "display": "VT323",
      "body": "IBM Plex Mono",
      "mono": "IBM Plex Mono",
      "display_case": "none",
      "scale": {
        "cover": 132,
        "headline": 100,
        "body": 38,
        "label": 34,
        "number": 330
      }
    },
    "layout": {
      "align": "left",
      "margin": 96,
      "texture": "none",
      "counter": false,
      "handle": true,
      "progress": true,
      "swipe_cue": true,
      "cta_fill": false
    }
  },
  "variants": {
    "amber": {
      "mode": "dark",
      "colors": {
        "bg": "#0B0703",
        "text": "#FFD48F",
        "muted": "#C98A2B",
        "accent": "#FFB000",
        "fill": "#FFB000",
        "on_fill": "#0B0703"
      }
    }
  },
  "options": {
    "texture": [
      "none"
    ],
    "variant": [
      "amber"
    ]
  }
}
